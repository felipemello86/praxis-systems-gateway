// Cópia local do schema suite_core (não usa o pacote packages/suite-core via
// `file:` dependency — o gateway é um repositório git separado, deployado
// isoladamente na Vercel, e não tem acesso ao caminho relativo
// "../../packages/suite-core" que só existe dentro do monorepo completo
// "Operacao Hoteleira Integrada"). O gateway só lê Tenant/TenantModule, então
// só esses dois modelos (+ o enum SuiteModule) estão aqui — se o schema
// suite_core mudar, replicar aqui também.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("SUITE_CORE_DATABASE_URL")
  schemas  = ["suite_core"]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules TenantModule[]

  @@schema("suite_core")
}

enum SuiteModule {
  BOOKING_REVIEWS
  HOUSEKEEPING
  MAINTENANCE

  @@schema("suite_core")
}

model TenantModule {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module   SuiteModule
  enabled  Boolean     @default(true)

  apiBaseUrl String?
  apiKeyHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, module])
  @@schema("suite_core")
}
