# Mesmo banco suite_core que os outros apps usam.
SUITE_CORE_DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require&channel_binding=require"

# URL base de cada app real (SEM o /governance, /reviews, /upkeep no final —
# o gateway acrescenta isso no rewrite). Deixe em branco enquanto o app
# correspondente não tiver o basePath configurado (ver task pendente).
GOVERNANCE_APP_URL=""
REVIEWS_APP_URL=""
UPKEEP_APP_URL="http://localhost:3000"
